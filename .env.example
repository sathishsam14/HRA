# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/hra?schema=public"

# Session encryption secret (min 32 characters)
SESSION_SECRET="your-random-32-or-64-character-session-secret"

# Default seed passwords for RBAC accounts
SEED_ADMIN_PASSWORD="AdminPassword123!"
SEED_HANDICAPPER_PASSWORD="HandicapperPassword123!"
SEED_MANAGER_PASSWORD="ManagerPassword123!"

# Track timing FTP ingestion config
FTP_MODE=local
FTP_HOST="ftp.bangaloreturfclub.com"
FTP_PORT=21
FTP_USER="btc_racing"
FTP_PASSWORD="ftp_secure_password"
FTP_PATH="/incoming/races"
